{
  "name": "peanut-connect",
  "version": "2.1.2",
  "description": "Peanut Connect - WordPress connector plugin for Peanut Suite",
  "private": true,
  "engines": {
    "node": "22.22.2",
    "npm": "10.9.7"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:frontend": "npm ci --prefix frontend --legacy-peer-deps",
    "runtime:verify": "node scripts/verify-runtime-contract.cjs",
    "clean": "rm -rf dist",
    "package": "bash scripts/package.sh",
    "bump": "bash scripts/bump-version.sh",
    "bump:patch": "bash scripts/bump-version.sh patch",
    "bump:minor": "bash scripts/bump-version.sh minor",
    "bump:major": "bash scripts/bump-version.sh major",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "peanut-suite",
    "monitoring",
    "health-check"
  ],
  "author": "Peanut Graphic",
  "license": "GPL-2.0-or-later"
}
