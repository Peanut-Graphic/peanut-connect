<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	failOnRisky="true"
>
	<testsuites>
		<!-- Default suite: the historical root mock-backed tests plus the
		     property/contract layers. Maintained tests/phpunit/unit modules run in
		     the blocking phpunit.legacy-unit.xml job because that suite needs its
		     own WordPress mock universe. ApiTest.php remains quarantined there. -->
		<!-- Net 1/unit: the mock-backed unit tests that actually run today.
		     This is also the historical default set (the root test-/Test_
		     prefixed files). Named "Unit" so CI can target it explicitly;
		     no other suite overlaps it, so a bare `phpunit` run never
		     double-counts. -->
		<testsuite name="Unit">
			<directory prefix="test-" suffix=".php">./tests/</directory>
			<!-- 3.9.4: also discover files named Test_Foo.php (matching
			     their class name) so PHPUnit 10's strict file/class
			     matcher can find them. -->
			<directory prefix="Test_" suffix=".php">./tests/</directory>
		</testsuite>
		<!-- Net 6: property-based / fuzz tests over pure functions. -->
		<testsuite name="Property">
			<directory suffix="Test.php">./tests/Property/</directory>
		</testsuite>
		<!-- Net 7: seam contracts. Empty until a WP harness can boot. -->
		<testsuite name="Contract">
			<directory suffix="Test.php">./tests/Contract/</directory>
		</testsuite>
	</testsuites>
	<!-- Coverage filter. PHPUnit 9.6 (the pinned runner) uses coverage/include,
	     not PHPUnit 10's source element. Without a recognised filter, the clover
	     coverage report emits nothing and the coverage gate fails (file not found). -->
	<coverage>
		<include>
			<directory suffix=".php">./includes/</directory>
		</include>
		<exclude>
			<directory suffix=".php">./vendor/</directory>
			<directory suffix=".php">./node_modules/</directory>
		</exclude>
	</coverage>
	<php>
		<const name="PEANUT_CONNECT_TEST_MODE" value="true"/>
	</php>
</phpunit>
